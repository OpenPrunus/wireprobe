[Unit]
Description=Wireprobe - WireGuard tunnel health probe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wireprobe
Group=wireprobe
ExecStart=/usr/bin/wireprobe run -s /etc/wireprobe/settings.yml
Restart=on-failure
RestartSec=5

# wg show ... dump needs to read the interface's private/preshared keys,
# so the service user needs CAP_NET_ADMIN instead of running as root.
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
